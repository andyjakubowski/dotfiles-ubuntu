# Only our own table is replaced, atomically. Never flush the host ruleset.
# Add tolerates an existing table; delete also removes old sets on reload.
add table inet codex_vm
delete table inet codex_vm
table inet codex_vm {
    set nonpublic_v4 {
        type ipv4_addr
        flags interval
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10,
                     127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
                     192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16,
                     198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
                     224.0.0.0/4, 240.0.0.0/4 }
    }
    chain input {
        type filter hook input priority -20; policy accept;
        iifname "virbr-codex" ct state established,related accept
        iifname "virbr-codex" meta nfproto ipv4 udp sport 68 udp dport 67 accept
        iifname "virbr-codex" ip saddr 192.168.250.2 ip daddr 192.168.250.1 udp dport 53 accept
        iifname "virbr-codex" ip saddr 192.168.250.2 ip daddr 192.168.250.1 tcp dport 53 accept
        iifname "virbr-codex" counter drop
    }
    chain forward {
        type filter hook forward priority -20; policy accept;
        iifname "virbr-codex" meta nfproto ipv6 counter drop
        iifname "virbr-codex" ip saddr != 192.168.250.2 counter drop
        iifname "virbr-codex" ip daddr @nonpublic_v4 counter drop
        oifname "virbr-codex" ct state established,related accept
        oifname "virbr-codex" counter drop
    }
}
